# Patterns here match from the build context root only. Anything meant to be
# excluded at any depth needs the **/ prefix: a bare "*.db" skipped the root's
# database but let `COPY app/` bake app/neo_memory.db into the image.

# VCS, editors, local tooling
.git
.gitignore
.venv
venv
.claude
.agents
.vscode
.idea
**/.DS_Store

# Python and Node build output
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
*.egg-info
build
dist
**/node_modules
frontend/dist
htmlcov
.coverage

# Secrets and per-machine settings
**/.env
**/.env.*
!.env.example
docker-compose.override.yml

# Runtime data, wherever a run happened to create it
data
profiles
**/profiles
workspaces
agent-state
isolation
engines
run-markers
voice-models
searxng
.neo-probe-record.json
:memory:.ses
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3
**/neo_llms.json
**/neo_llms.json.tmp
**/*.log

# Not part of the image
tests
